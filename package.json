{
  "name": "blindqa",
  "version": "0.3.0",
  "description": "Human-like QA for any web app: Playwright drives it like a person on whatever browser this machine has (local, headless, CDP, n.eko, Orca), scripts do every check and re-test only what code changes touch, and nothing it writes ever reaches a git remote.",
  "homepage": "https://github.com/DevZonayed/blindqa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevZonayed/blindqa.git"
  },
  "bugs": {
    "url": "https://github.com/DevZonayed/blindqa/issues"
  },
  "type": "module",
  "bin": {
    "blindqa": "bin/blindqa.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "mcp": "node mcp/server.mjs",
    "postinstall": "node bin/blindqa.mjs setup --quiet || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "license": "MIT",
  "private": true
}
