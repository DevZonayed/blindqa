{
  "name": "blindqa-site",
  "private": true,
  "type": "module",
  "description": "The blindqa landing page: React + Tailwind, pre-rendered to static HTML in ../docs/index.html for GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && npx --yes serve ../docs -l 4317",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
